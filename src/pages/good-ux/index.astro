---
import GoodUXApp from '../../components/goodux/GoodUXApp';
// Same self-hosted Inter the rest of the site loads. Without this the board
// falls back to the system sans-serif, which is why its title looked different.
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '../../styles/goodux.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="An appreciation board for all the little things I've come across in life and on the internet that I thought were good UX."
    />
    <title>Good UX - An appreciation board</title>
    <link rel="icon" type="image/webp" href="/favicon.webp" />
  </head>
  <body>
    <GoodUXApp client:load />
  </body>
</html>
