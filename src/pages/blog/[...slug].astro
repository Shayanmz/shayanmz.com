---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={`${post.data.title} | Shayan Memarzadeh`} active="blog">
  {
    post.data.cover && (
      <div class="post-cover">
        <img src={post.data.cover} alt="" />
      </div>
    )
  }
  <main class:list={['page', { 'has-cover': !!post.data.cover }]}>
    <header class="post-header">
      {post.data.icon && <span class="post-icon">{post.data.icon}</span>}
      <h1 class="page-title">{post.data.title}</h1>
    </header>
    <article class="prose-site">
      <Content />
    </article>
  </main>
</Base>
